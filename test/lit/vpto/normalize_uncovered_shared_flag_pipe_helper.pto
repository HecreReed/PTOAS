// A helper function cannot guess ownership of a shared synchronization pipe
// from its dedicated peer; callers may execute it on either physical core.
// RUN: not pto-test-opt --pto-normalize-uncovered-tile-sections %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
    func.func private @shared_flag_pipe_helper() {
      pto.wait_flag[<PIPE_S>, <PIPE_MTE2>, <EVENT_ID0>]
      return
    }
    func.func @entry() attributes {pto.entry} {
      func.call @shared_flag_pipe_helper() : () -> ()
      return
    }
  }
}

// CHECK: contains an uncovered top-level op segment whose section kind cannot be inferred uniquely
// CHECK-SAME: ambiguous op(s): 'pto.wait_flag'
