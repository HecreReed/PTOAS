// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto %s -o - 2>&1 | FileCheck %s
// A2/A3 VPTO: an unresolved dual-output TEXTRACT from unsupported dynamic
// indices must fail in the pass instead of leaking into LLVM emission.
// (The verifier already rejects dynamic indices in the first version; this
// guards the pointer-form residual scan in LowerPTOToUBufOps.)

module attributes {"pto.target_arch" = "a3", "pto.backend" = "vpto"} {
  func.func @textract_nd2xnz_vpto_bad() {
    %r0 = arith.constant 0 : index
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %r0, %c0, %r0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}
