// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %S/../pto/fixpipe_frontend_emitc_vector_quant_a5.pto -o /dev/null 2>&1 | FileCheck %s

// The referenced frontend fixture is intentionally not a normalized VPTO
// container. It must nevertheless pass TileLib metadata discovery first:
// set_quant_vector exposes PIPE_FIX for synchronization, but is a config op
// without a TileLib template.
//
// CHECK-NOT: NoMatchingTemplate
// CHECK-NOT: no template registered for op='pto.set_quant_vector'
// CHECK: expected VPTO container top level to contain only kernel submodules
