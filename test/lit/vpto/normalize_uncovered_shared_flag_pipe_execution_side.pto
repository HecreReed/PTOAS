// Guard: a shared peer does not make a flag ambiguous when the pipe that
// executes the operation has dedicated vector/cube ownership.
// RUN: pto-test-opt --pto-normalize-uncovered-tile-sections %s | FileCheck %s

module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
  func.func @shared_peer_flags() attributes {pto.entry} {
    pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    return
  }
}

// CHECK: module attributes {{.*}}pto.kernel_kind = #pto.kernel_kind<vector>
// CHECK: func.func @shared_peer_flags
// CHECK-NEXT: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
