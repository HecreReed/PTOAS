// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

// UB <-> L1 transfers explicitly implement CubeMicroOpInterface: their
// physical ownership does not depend on source/destination address priority.

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
    func.func @mte_cross_memory(%ub: !pto.ptr<f16, ub>,
                                %l1: !pto.ptr<f16, l1>) attributes {pto.entry} {
      %c1 = arith.constant 1 : i64
      %c16 = arith.constant 16 : i64
      %c32 = arith.constant 32 : i64
      %c64 = arith.constant 64 : i64
      pto.mte_ub_l1 %ub, %l1, %c16
        nburst(%c1, %c32, %c64)
        : !pto.ptr<f16, ub>, !pto.ptr<f16, l1>, i64, i64, i64, i64
      pto.mte_l1_ub %l1, %ub, %c16
        nburst(%c1, %c32, %c64)
        : !pto.ptr<f16, l1>, !pto.ptr<f16, ub>, i64, i64, i64, i64
      return
    }
  }
}

// CHECK: module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<cube>
// CHECK: func.func @mte_cross_memory
// CHECK: pto.copy_ubuf_to_cbuf
// CHECK: pto.copy_cbuf_to_ubuf
// CHECK-NOT: pto.kernel_kind = #pto.kernel_kind<vector>
