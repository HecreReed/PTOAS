// Guards the data-width-specific vscatter offset shape.
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vscatter_b8_bad_offsets(%value: !pto.vreg<256xui8>, %dst: !pto.ptr<ui8, ub>,
                                     %offsets: !pto.vreg<64xui32>, %mask: !pto.mask<b16>) attributes {pto.kernel} {
    pto.vecscope {
      pto.vscatter %value, %dst, %offsets, %mask : !pto.vreg<256xui8>, !pto.ptr<ui8, ub>, !pto.vreg<64xui32>, !pto.mask<b16>
    }
    return
  }
}

// CHECK: error: 'pto.vscatter' op requires 16-bit offset vector elements for 8-bit values
