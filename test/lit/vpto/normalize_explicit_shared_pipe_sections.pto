// Guard: explicit physical sections resolve shared-pipe synchronization that
// automatic section inference cannot classify uniquely.
// RUN: pto-test-opt --pto-normalize-uncovered-tile-sections %s | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @explicit_shared_pipe_sync() attributes {pto.kernel} {
    pto.section.cube {
      pto.set_flag[<PIPE_MTE2>, <PIPE_S>, <EVENT_ID0>]
    }
    pto.section.vector {
      pto.wait_flag[<PIPE_MTE2>, <PIPE_S>, <EVENT_ID0>]
    }
    return
  }
}

// CHECK: pto.section.cube {
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_S>, <EVENT_ID0>]
// CHECK-NEXT: }
// CHECK: pto.section.vector {
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_S>, <EVENT_ID0>]
// CHECK-NEXT: }
