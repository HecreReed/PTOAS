// RUN: split-file %s %t
// RUN: yaml2obj %t/object.yaml -o %t/raw.o
// RUN: pto-vfsimt-size-patcher-test %t/module.ll %t/raw.o %t/patched.o auto 2>&1 | FileCheck %s --check-prefix=AUTO
// RUN: pto-vfsimt-size-patcher-test %t/module.ll %t/patched.o %t/unused.o verify 2>&1 | FileCheck %s --check-prefix=VERIFY-PATCHED
// RUN: not pto-vfsimt-size-patcher-test %t/module.ll %t/raw.o %t/unused.o verify 2>&1 | FileCheck %s --check-prefix=VERIFY-RAW
// RUN: pto-vfsimt-size-patcher-test %t/module.ll %t/raw.o %t/unused.o off 2>&1 | FileCheck %s --check-prefix=OFF
// RUN: pto-vfsimt-size-patcher-test %t/no-simt.ll %t/raw.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=NO-SIMT
// RUN: yaml2obj %t/expanded-call.yaml -o %t/expanded-call.o
// RUN: pto-vfsimt-size-patcher-test %t/one-call.ll %t/expanded-call.o %t/expanded-call-patched.o auto 2>&1 | FileCheck %s --check-prefix=EXPANDED-CALL
// RUN: yaml2obj %t/variable-control.yaml -o %t/variable-control.o
// RUN: pto-vfsimt-size-patcher-test %t/module.ll %t/variable-control.o %t/variable-control-patched.o auto 2>&1 | FileCheck %s --check-prefix=VARIABLE-CONTROL
// RUN: yaml2obj -DMOVPC=80084C02 -DMOVI=08000E07 -DSHLI=0202CE02 %t/unsupported-sequence.yaml -o %t/bad-mov-pc.o
// RUN: not pto-vfsimt-size-patcher-test %t/one-call.ll %t/bad-mov-pc.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=BAD-SEQUENCE
// RUN: yaml2obj -DMOVPC=80080C02 -DMOVI=08004E07 -DSHLI=0202CE02 %t/unsupported-sequence.yaml -o %t/bad-movi.o
// RUN: not pto-vfsimt-size-patcher-test %t/one-call.ll %t/bad-movi.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=BAD-SEQUENCE
// RUN: yaml2obj -DMOVPC=80080C02 -DMOVI=08000E07 -DSHLI=02020E02 %t/unsupported-sequence.yaml -o %t/bad-shli.o
// RUN: not pto-vfsimt-size-patcher-test %t/one-call.ll %t/bad-shli.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=BAD-SEQUENCE
// RUN: yaml2obj %t/compiler-sized.yaml -o %t/compiler-sized.o
// RUN: pto-vfsimt-size-patcher-test %t/one-call-no-asm.ll %t/compiler-sized.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=COMPILER-SIZED
// RUN: yaml2obj %t/invalid-finite-size.yaml -o %t/invalid-finite-size.o
// RUN: not pto-vfsimt-size-patcher-test %t/one-call-no-asm.ll %t/invalid-finite-size.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=INVALID-FINITE-SIZE
// RUN: yaml2obj %t/bad-target.yaml -o %t/bad-target.o
// RUN: not pto-vfsimt-size-patcher-test %t/module.ll %t/bad-target.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=BAD-TARGET
// RUN: yaml2obj %t/zero-size.yaml -o %t/zero-size.o
// RUN: not pto-vfsimt-size-patcher-test %t/module.ll %t/zero-size.o %t/unused.o auto 2>&1 | FileCheck %s --check-prefix=ZERO-SIZE
// RUN: yaml2obj %t/pre-suffixed.yaml -o %t/pre-suffixed.o
// RUN: pto-vfsimt-size-patcher-test %t/pre-suffixed.ll %t/pre-suffixed.o %t/pre-suffixed-patched.o auto 2>&1 | FileCheck %s --check-prefix=PRE-SUFFIXED
// RUN: yaml2obj %t/large-offset.yaml -o %t/large-offset.o
// RUN: pto-vfsimt-size-patcher-test %t/large-offset.ll %t/large-offset.o %t/large-offset-patched.o auto 2>&1 | FileCheck %s --check-prefix=LARGE-OFFSET

// AUTO: PTOAS: patched VF_SIMT size
// AUTO: caller: kernel_mix_aiv
// AUTO: callee: stage0_simt_entry
// AUTO: symbol size: 16 bytes
// AUTO: PTOAS: patched VF_SIMT size
// AUTO: callee: stage1_simt_entry
// AUTO: symbol size: 32 bytes
// AUTO: changed=1 verified=2 patched=2 object={{.*}}patched.o

// VERIFY-PATCHED: PTOAS: VF_SIMT size verification passed; no patch required
// VERIFY-PATCHED: changed=0 verified=2 patched=0 object={{.*}}patched.o

// VERIFY-RAW: Error: VF_SIMT size patch: caller 'kernel_mix_aiv' has the known invalid VF_SIMT code size 0xffff for callee 'stage0_simt_entry'

// OFF-NOT: VF_SIMT size
// OFF: changed=0 verified=0 patched=0 object={{.*}}raw.o

// NO-SIMT: PTOAS: VF_SIMT size verification passed; no patch required
// NO-SIMT: changed=0 verified=0 patched=0 object={{.*}}raw.o

// EXPANDED-CALL: PTOAS: patched VF_SIMT size
// EXPANDED-CALL: caller: kernel_mix_aiv
// EXPANDED-CALL: callee: stage0_simt_entry
// EXPANDED-CALL: PTOAS: patched VF_SIMT size
// EXPANDED-CALL: callee: stage0_simt_entry
// EXPANDED-CALL: changed=1 verified=2 patched=2 object={{.*}}expanded-call-patched.o

// VARIABLE-CONTROL: PTOAS: patched VF_SIMT size
// VARIABLE-CONTROL: PTOAS: patched VF_SIMT size
// VARIABLE-CONTROL: changed=1 verified=2 patched=2 object={{.*}}variable-control-patched.o

// BAD-SEQUENCE: Error: VF_SIMT size patch: caller 'kernel_mix_aiv' uses an unsupported VF_SIMT target sequence at 0x18

// COMPILER-SIZED: PTOAS: VF_SIMT size verification passed; no patch required
// COMPILER-SIZED: changed=0 verified=1 patched=0 object={{.*}}compiler-sized.o

// INVALID-FINITE-SIZE: Error: VF_SIMT size patch: caller 'kernel_mix_aiv' has VF_SIMT code size 29 outside callee 'stage0_simt_entry' symbol size 28

// BAD-TARGET: Error: VF_SIMT size patch: caller 'kernel_mix_aiv' VF_SIMT target 0x44 does not match any LLVM direct-call callee

// ZERO-SIZE: Error: VF_SIMT size patch: function 'stage0_simt_entry' has an invalid ELF symbol range

// PRE-SUFFIXED: callee: stage0_simt_entry_simt_entry
// PRE-SUFFIXED: changed=1 verified=1 patched=1 object={{.*}}pre-suffixed-patched.o

// LARGE-OFFSET: callee: large_stage_simt_entry
// LARGE-OFFSET: changed=1 verified=1 patched=1 object={{.*}}large-offset-patched.o

//--- module.ll
define void @kernel_mix_aiv() {
  call simt_entry void @stage0()
  call simt_entry void @stage1()
  ret void
}

define linkonce_odr simt_entry void @stage0() {
  call void asm sideeffect "", ""()
  ret void
}

define linkonce_odr simt_entry void @stage1() {
  call void asm sideeffect "", ""()
  ret void
}

//--- pre-suffixed.ll
define void @kernel_mix_aiv() {
  call simt_entry void @stage0_simt_entry()
  ret void
}

define linkonce_odr simt_entry void @stage0_simt_entry() {
  call void asm sideeffect "", ""()
  ret void
}

//--- large-offset.ll
define void @large_kernel_mix_aiv() {
  call simt_entry void @large_stage()
  ret void
}

define linkonce_odr simt_entry void @large_stage() {
  call void asm sideeffect "", ""()
  ret void
}

//--- no-simt.ll
define void @plain_kernel() {
  ret void
}

//--- one-call.ll
define void @kernel_mix_aiv() {
  call simt_entry void @stage0()
  ret void
}

define linkonce_odr simt_entry void @stage0() {
  call void asm sideeffect "", ""()
  ret void
}

//--- one-call-no-asm.ll
define void @kernel_mix_aiv() {
  call simt_entry void @stage0()
  ret void
}

define linkonce_odr simt_entry void @stage0() {
  ret void
}

//--- expanded-call.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: 0x1029
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 0x8
    Content:      80080C0210000E0700004041000040410202CE0201730E00002C2715FCFFFF1580080C0208002C0700004041000040410202EC0201632D00002C3615FCFFFF1500004041000040410000404100004041
Symbols:
  - Name:    kernel_mix_aiv
    Type:    STT_FUNC
    Section: .text
    Binding: STB_GLOBAL
    Size:    0x40
  - Name:    stage0_simt_entry
    Type:    STT_FUNC
    Section: .text
    Binding: STB_WEAK
    Value:   0x40
    Size:    0x10
...

