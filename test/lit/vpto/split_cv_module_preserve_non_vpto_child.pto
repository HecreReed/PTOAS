// The CV splitter may flatten only its VPTO backend container. An EmitC child
// is an independent backend ABI boundary and must remain nested.
// RUN: pto-test-opt --vpto-split-cv-module %s | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "emitc", pto.target_arch = "a5"} {
    func.func @emitc_child() {
      pto.section.vector {
        pto.sync.set <PIPE_V>, 0
      }
      return
    }
  }
}

// CHECK: module attributes {pto.target_arch = "a5"} {
// CHECK: module attributes {pto.backend = "emitc", pto.target_arch = "a5"} {
// CHECK: func.func @emitc_child

