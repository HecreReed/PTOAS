// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @gs2_extui_ui8_to_ui16(
      %src: !pto.vmi.vreg<2xui8, #pto.vmi.layout<num_groups = 2, slots = 2>>)
      -> !pto.vmi.vreg<2xui16, #pto.vmi.layout<num_groups = 2, slots = 2>> {
    %result = pto.vmi.extui %src
        : !pto.vmi.vreg<2xui8, #pto.vmi.layout<num_groups = 2, slots = 2>>
        -> !pto.vmi.vreg<2xui16, #pto.vmi.layout<num_groups = 2, slots = 2>>
    return %result
        : !pto.vmi.vreg<2xui16, #pto.vmi.layout<num_groups = 2, slots = 2>>
  }

  func.func @gs4_extsi_si16_to_si32(
      %src: !pto.vmi.vreg<4xsi16, #pto.vmi.layout<num_groups = 4, slots = 4>>)
      -> !pto.vmi.vreg<4xsi32, #pto.vmi.layout<num_groups = 4, slots = 4>> {
    %result = pto.vmi.extsi %src
        : !pto.vmi.vreg<4xsi16, #pto.vmi.layout<num_groups = 4, slots = 4>>
        -> !pto.vmi.vreg<4xsi32, #pto.vmi.layout<num_groups = 4, slots = 4>>
    return %result
        : !pto.vmi.vreg<4xsi32, #pto.vmi.layout<num_groups = 4, slots = 4>>
  }

  func.func @gs8_extui_ui8_to_ui32(
      %src: !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %result = pto.vmi.extui %src
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %result
        : !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }

  func.func @gs8_extsi_i8_to_i32(
      %src: !pto.vmi.vreg<8xsi8, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %result = pto.vmi.extsi %src
        : !pto.vmi.vreg<8xsi8, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %result
        : !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
}

// CHECK-LABEL: func.func @gs2_extui_ui8_to_ui16(
// CHECK: pto.vzunpack {{.*}} : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK-NOT: pto.vcvt

// CHECK-LABEL: func.func @gs4_extsi_si16_to_si32(
// CHECK: pto.vsunpack {{.*}} : !pto.vreg<128xsi16> -> !pto.vreg<64xsi32>
// CHECK-NOT: pto.vcvt

// CHECK-LABEL: func.func @gs8_extui_ui8_to_ui32(
// CHECK: %[[U16:.*]] = pto.vzunpack {{.*}} : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: pto.vzunpack %[[U16]], {{.*}} : !pto.vreg<128xui16> -> !pto.vreg<64xui32>
// CHECK-NOT: pto.vcvt

// CHECK-LABEL: func.func @gs8_extsi_i8_to_i32(
// CHECK: %[[S16:.*]] = pto.vsunpack {{.*}} : !pto.vreg<256xsi8> -> !pto.vreg<128xsi16>
// CHECK: pto.vsunpack %[[S16]], {{.*}} : !pto.vreg<128xsi16> -> !pto.vreg<64xsi32>
// CHECK-NOT: pto.vcvt
