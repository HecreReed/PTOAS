// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s -o - | FileCheck %s

module attributes {"pto.target_arch" = "a5"} {
  func.func @textract_nd2xnz_parse_print() {
    %r0 = arith.constant 8 : index
    %c0 = arith.constant 16 : index
    %r1 = arith.constant 24 : index
    %c1 = arith.constant 48 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=13, v_col=29, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %r0, %c0, %r1, %c1 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=13, v_col=29, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: func.func @textract_nd2xnz_parse_print()
// CHECK: pto.textract ins({{.*}} index, index, index, index)
// CHECK-SAME: outs({{.*}})
