// Object compilation promotes a backend child to an independent top-level
// compile unit before the shared pipeline. Its explicit section must still be
// split into a kernel-kind module before the expected toolchain-only failure.
// RUN: env -u ASCEND_HOME_PATH -u ASCEND_TOOLKIT_HOME not ptoas --pto-arch=a5 %s -o %t.o 2>&1 | FileCheck %s

module attributes {pto.mode = "explicit", pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
    func.func @single_child_compile_unit() attributes {pto.entry} {
      pto.section.vector {
        %ctrl = pto.get_ctrl : i64
        pto.set_ctrl %ctrl : i64
      }
      return
    }
  }
}

// CHECK: Error: CANN toolchain is required but was not initialized.
// CHECK-NOT: expected VPTO kernel submodule to carry 'pto.kernel_kind'
