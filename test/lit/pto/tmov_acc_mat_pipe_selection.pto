// RUN: ptoas --pto-arch a5 --enable-insert-sync %s | FileCheck %s

module attributes {"pto.device-spec" = "Ascend950"} {
  // A5: tmov acc->mat should be treated as PIPE_FIX for sync insertion.
  func.func @tmov_acc_mat_pipeline(
      %a: !pto.partition_tensor_view<32x32xf16>,
      %b: !pto.partition_tensor_view<32x32xf16>) {
    %a_mat = pto.alloc_tile : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>
    %b_mat = pto.alloc_tile : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>
    %a_left = pto.alloc_tile : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>
    %b_right = pto.alloc_tile : !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>
    %acc = pto.alloc_tile : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %dst_mat = pto.alloc_tile : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>
    %dst_left = pto.alloc_tile : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>

    pto.tload ins(%a : !pto.partition_tensor_view<32x32xf16>)
              outs(%a_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
    pto.tload ins(%b : !pto.partition_tensor_view<32x32xf16>)
              outs(%b_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
    pto.tmov ins(%a_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
             outs(%a_left : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>)
    pto.tmov ins(%b_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
             outs(%b_right : !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>)
    pto.tmatmul ins(%a_left, %b_right : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>,
                                        !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>)
                outs(%acc : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%acc : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>)
             outs(%dst_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
    pto.tmov ins(%dst_mat : !pto.tile_buf<mat, 32x32xf16, blayout=col_major, slayout=row_major>)
             outs(%dst_left : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>)
    return
  }
}

// CHECK-LABEL: AICORE void tmov_acc_mat_pipeline(
// CHECK: set_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
// CHECK: wait_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
// CHECK: TMOV(
// CHECK: set_flag(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
// CHECK: wait_flag(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
