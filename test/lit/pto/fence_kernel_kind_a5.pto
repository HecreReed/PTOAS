// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s

module {
  func.func @cube_fence() attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    pto.fence.barrier_all #pto.fence_scope<gm>
    return
  }

  func.func @vector_fence() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.fence.barrier_all #pto.fence_scope<gm>
    return
  }
}

// CHECK-LABEL: AICORE void cube_fence()
// CHECK: pipe_barrier(PIPE_MTE2);
// CHECK-NEXT: pipe_barrier(PIPE_MTE3);
// CHECK-NEXT: pipe_barrier(PIPE_FIX);
// CHECK-NEXT: dsb(DSB_DDR);

// CHECK-LABEL: AICORE void vector_fence()
// CHECK: pipe_barrier(PIPE_MTE2);
// CHECK-NEXT: pipe_barrier(PIPE_MTE3);
// CHECK-NEXT: dsb(DSB_DDR);
// CHECK-NOT: pipe_barrier(PIPE_FIX);
