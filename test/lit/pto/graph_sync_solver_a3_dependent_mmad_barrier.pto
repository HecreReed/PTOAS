// RUN: ptoas --pto-arch=a3 --enable-graph-sync-solver --graph-sync-solver-event-id-max=64 --emit-pto-ir %s | FileCheck %s --check-prefix=A3
// RUN: ptoas --pto-arch=a5 --enable-graph-sync-solver --graph-sync-solver-event-id-max=64 --emit-pto-ir %s | FileCheck %s --check-prefix=A5

module {
  // A3-LABEL: func.func @dependent_mmad_same_acc
  // A3: pto.tmatmul
  // A3-NEXT: pto.barrier <PIPE_M>
  // A3-NEXT: pto.tmatmul.acc
  // A5-LABEL: func.func @dependent_mmad_same_acc
  // A5: pto.tmatmul
  // A5-NEXT: pto.tmatmul.acc
  func.func @dependent_mmad_same_acc(
      %lhs: !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>,
      %rhs: !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>,
      %acc: !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>) {
    pto.tmatmul ins(%lhs, %rhs : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>, !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>) outs(%acc : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmatmul.acc ins(%acc, %lhs, %rhs : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major>, !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major>) outs(%acc : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    return
  }
}
