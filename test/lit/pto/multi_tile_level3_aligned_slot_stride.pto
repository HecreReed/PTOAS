// RUN: ptoas --pto-level=level3 --pto-arch=a3 --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-resolve-buffer-select %s 2>&1 1>/dev/null \
// RUN:   | FileCheck %s

module {
  func.func @aligned_l0_slot_stride() attributes {pto.entry} {
    %base = arith.constant 0 : i64
    %slot = arith.constant 1 : index
    %multi = pto.alloc_multi_tile addr = %base
      : !pto.multi_tile_buf<!pto.tile_buf<loc=left, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
    %selected = pto.multi_tile_get %multi[%slot]
      : !pto.multi_tile_buf<!pto.tile_buf<loc=left, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
     -> !pto.tile_buf<loc=left, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    func.call @consume(%selected)
      : (!pto.tile_buf<loc=left, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) -> ()
    return
  }

  func.func private @consume(
    !pto.tile_buf<loc=left, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
}

// One slot occupies 32 bytes, but LEFT addresses require 512-byte alignment.
// CHECK: %[[STRIDE:.*]] = arith.constant 512 : i64
// CHECK: arith.addi %{{.*}}, %[[STRIDE]] : i64
