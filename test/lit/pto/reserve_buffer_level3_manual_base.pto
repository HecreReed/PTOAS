// RUN: ptoas --pto-level=level3 --pto-arch=a3 --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s 2>&1 1>/dev/null | FileCheck %s

module {
  func.func @manual_base_level3() {
    %fifo = pto.reserve_buffer {
      name = "fifo",
      size = 8192,
      location = #pto.address_space<vec>,
      auto = false,
      base = 0
    } -> i32
    return
  }
}

// CHECK-LABEL: func.func @manual_base_level3
// CHECK: arith.constant 0 : i32
// CHECK-NOT: pto.reserve_buffer
