// RUN: ptoas --pto-arch=a5 %s | FileCheck %s

module {
  func.func @tsync_emitc(%src0: !pto.partition_tensor_view<32x32xf32>,
                         %src1: !pto.partition_tensor_view<32x32xf32>) {
    pto.tsync ins(%src0, %src1 : !pto.partition_tensor_view<32x32xf32>, !pto.partition_tensor_view<32x32xf32>)

    return
  }
}

// CHECK-LABEL: AICORE void tsync_emitc(
// CHECK: TSYNC(
