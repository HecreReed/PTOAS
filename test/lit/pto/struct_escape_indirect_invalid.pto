// RUN: not ptoas %s 2>&1 | FileCheck %s

// Function results must not expose a stack-local struct pointer. A declaration
// has no pto.declare_struct producer for the per-op escape verifier to inspect,
// so the module provenance validation owns this signature-level restriction.

module {
  func.func private @passthrough() -> !pto.struct<f32, i8>
}

// CHECK: a stack-local struct must not be returned
