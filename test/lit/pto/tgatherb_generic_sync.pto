//
// TGatherB uses the generic OpPipeInterface and MemoryEffects path. Both MTE2
// loads must complete before the PIPE_V gather reads src and offsets.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  func.func @tgatherb_generic_sync(
      %src_gm: !pto.partition_tensor_view<1x64xf32>,
      %off_gm: !pto.partition_tensor_view<1x8xi32>,
      %dst_gm: !pto.partition_tensor_view<1x64xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %c288_i64 = arith.constant 288 : i64
    %src = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %off = pto.alloc_tile addr = %c256_i64 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c288_i64 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%src_gm : !pto.partition_tensor_view<1x64xf32>) outs(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%off_gm : !pto.partition_tensor_view<1x8xi32>) outs(%off : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tgatherb ins(%src, %off : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst_gm : !pto.partition_tensor_view<1x64xf32>)
    return
  }
}

// CHECK-LABEL: AICORE void tgatherb_generic_sync(
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_V, EVENT_ID[[LOAD_TO_GATHER:[0-9]+]]);
// CHECK-NEXT: wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID[[LOAD_TO_GATHER]]);
// CHECK-NEXT: TGATHERB(
