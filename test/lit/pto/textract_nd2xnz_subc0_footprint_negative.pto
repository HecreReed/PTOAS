// RUN: not ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s
// Negative: a sub-c0 source column whose vldas/vldus read footprint crosses
// the source row end is rejected on A5 (design 9.2 vector read paths).

module attributes {"pto.target_arch" = "a5"} {
  func.func @textract_nd2xnz_subc0_footprint() {
    // src physical cols 32 (f16, c0=16): a window at col 17 with validCols 1
    // would read a full c0 vreg from col 17 (17..32) past the row end.
    %c0 = arith.constant 0 : index
    %c17 = arith.constant 17 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %d0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %d1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=1, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c17, %c0, %c17 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                outs(%d0, %d1 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=1, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// CHECK: sub-c0 ND-to-2xNZ TEXTRACT window indexCol
// CHECK-SAME: vldas/vldus footprint would read past the source row end
