// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tsetval_arg(
      %dst: !pto.tile_buf<vec, 16x16xf32>,
      %offset: index,
      %val: f32) {
    pto.tsetval ins(%offset, %val : index, f32)
                outs(%dst : !pto.tile_buf<vec, 16x16xf32>)
    return
  }

  func.func private @tgetval_arg(
      %src: !pto.tile_buf<vec, 16x16xf32>,
      %offset: index) -> f32 {
    %val = pto.tgetval ins(%src, %offset : !pto.tile_buf<vec, 16x16xf32>, index)
             outs : f32
    return %val : f32
  }
}

// NATIVE-LABEL: func.func private @tsetval_arg(
// NATIVE: pto.tsetval ins(%arg1, %arg2 : index, f32) outs(%arg0 : !pto.tile_buf<vec, 16x16xf32>)
// NATIVE-LABEL: func.func private @tgetval_arg(
// NATIVE-SAME: -> f32
// NATIVE: %0 = pto.tgetval ins(%arg0, %arg1 : !pto.tile_buf<vec, 16x16xf32>, index) outs : f32
// NATIVE: return %0 : f32
// NATIVE-NOT: memref<

// EMITC-LABEL: tsetval_arg(
// EMITC: .SetValue(
// EMITC-LABEL: tgetval_arg(
// EMITC: .GetValue(
