// RUN: not ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --check-prefix=A5

// Vector (per-channel) quant modes require a runtime Scaling-tile operand
// for SET_QUANT_VECTOR, which is not yet wired through pto.tpush. The verifier
// rejects them so users do not silently get wrong results.

module {
  func.func @cube_vdeqf16(%b: memref<256xf32, #pto.address_space<gm>>,
                          %c: i32) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %pipe = pto.initialize_l2g2l_pipe {dir_mask = 1, slot_size = 1024, slot_num = 8, local_slot_num = 8, flag_base = 0}(%b : memref<256xf32, #pto.address_space<gm>>, %c : i32) -> !pto.pipe
    %t = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tpush(%t, %pipe : !pto.tile_buf<loc=acc, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>, !pto.pipe) {split = 0, quant_pre_mode = #pto<quant_pre_mode deqf16_vec>}
    return
  }
}

// A5: vector quant_pre_mode is not supported by fixpipe TPUSH yet
