// RUN: ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @valid_workspaces(
      %ptr: !pto.ptr<i32, gm>,
      %multidim: !pto.partition_tensor_view<4x4xi32>,
      %dynamic: !pto.tensor_view<?xi32>,
      %overflowing_capacity: !pto.partition_tensor_view<4611686018427387904x4xi32>,
      %tensor_view: !pto.tensor_view<16xi32>,
      %partition_view: !pto.partition_tensor_view<16xi32>) {
    pto.syncall(%ptr : !pto.ptr<i32, gm>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall(%multidim : !pto.partition_tensor_view<4x4xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aic_only>
    pto.syncall(%dynamic : !pto.tensor_view<?xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    pto.syncall(%overflowing_capacity : !pto.partition_tensor_view<4611686018427387904x4xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    pto.syncall(%tensor_view : !pto.tensor_view<16xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall(%partition_view : !pto.partition_tensor_view<16xi32>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aic_only>
    return
  }
}

// CHECK-LABEL: func.func @valid_workspaces(
// CHECK-COUNT-6: pto.syncall(
