// RUN: ptoas --pto-arch=a3 --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 | FileCheck %s --check-prefixes=NATIVE,COMMON
// RUN: ptoas --pto-arch=a3 --mlir-print-ir-before=pto-inline-backend-helpers %s -o /dev/null 2>&1 | FileCheck %s --check-prefixes=MATERIALIZED,COMMON
// RUN: ptoas --pto-arch=a3 %s -o - 2>&1 | FileCheck %s --check-prefix=EMITC
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>&1 | FileCheck %s --check-prefix=VPTO

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @control_flow_result_tile_materialization(%cond: i1) {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %add = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %mul = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>

    %selected = scf.if %cond -> (!pto.tile_buf<vec, 16x16xf16>) {
      pto.tadd ins(%src, %src
        : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
        outs(%add : !pto.tile_buf<vec, 16x16xf16>)
      scf.yield %add : !pto.tile_buf<vec, 16x16xf16>
    } else {
      pto.tmul ins(%src, %src
        : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
        outs(%mul : !pto.tile_buf<vec, 16x16xf16>)
      scf.yield %mul : !pto.tile_buf<vec, 16x16xf16>
    }

    pto.tadd ins(%selected, %selected
      : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
      outs(%dst : !pto.tile_buf<vec, 16x16xf16>)
    return
  }

  func.func @loop_carried_tile_materialization() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>

    %result = scf.for %i = %c0 to %c2 step %c1
        iter_args(%iter = %src) -> (!pto.tile_buf<vec, 16x16xf16>) {
      pto.tadd ins(%iter, %iter
        : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
        outs(%tmp : !pto.tile_buf<vec, 16x16xf16>)
      scf.yield %tmp : !pto.tile_buf<vec, 16x16xf16>
    }

    pto.tmul ins(%result, %result
      : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
      outs(%src : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}

// NATIVE: IR Dump After PTOResolveReservedBuffers
// MATERIALIZED: IR Dump Before PTOInlineBackendHelpers
// COMMON: %[[SEL:.*]] = scf.if {{.*}} -> (!pto.tile_buf<vec, 16x16xf16>) {
// COMMON:   pto.tadd
// COMMON:   scf.yield %{{.*}} : !pto.tile_buf<vec, 16x16xf16>
// COMMON: } else {
// COMMON:   pto.tmul
// COMMON:   scf.yield %{{.*}} : !pto.tile_buf<vec, 16x16xf16>
// COMMON: }
// COMMON: pto.tadd ins(%[[SEL]], %[[SEL]]
// COMMON-LABEL: func.func @loop_carried_tile_materialization
// COMMON: %[[RES:.*]] = scf.for {{.*}} -> (!pto.tile_buf<vec, 16x16xf16>) {
// COMMON:   pto.tadd
// COMMON:   scf.yield %{{.*}} : !pto.tile_buf<vec, 16x16xf16>
// COMMON: }
// COMMON: pto.tmul ins(%[[RES]], %[[RES]]

// EMITC-LABEL: AICORE void control_flow_result_tile_materialization
// EMITC: if (
// EMITC: TADD(
// EMITC: } else {
// EMITC: TMUL(
// EMITC: TADD(
// EMITC-LABEL: AICORE void loop_carried_tile_materialization
// EMITC: for (
// EMITC: TADD(
// EMITC: TMUL(

// VPTO-LABEL: func.func @control_flow_result_tile_materialization
// VPTO: %[[SELECTED:.*]] = arith.select {{.*}} : !pto.tile_buf<vec, 16x16xf16>
// VPTO: pto.tile_buf_addr %[[SELECTED]] : !pto.tile_buf<vec, 16x16xf16> -> !pto.ptr<f16, ub>
// VPTO-LABEL: func.func @loop_carried_tile_materialization
// VPTO: %[[RESULT:.*]] = scf.for
// VPTO: scf.yield {{.*}} : !pto.tile_buf<vec, 16x16xf16>
// VPTO: pto.tile_buf_addr %[[RESULT]] : !pto.tile_buf<vec, 16x16xf16> -> !pto.ptr<f16, ub>
