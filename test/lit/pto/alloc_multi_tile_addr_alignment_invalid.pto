// RUN: not ptoas --pto-level=level3 --pto-arch=a3 %s 2>&1 | FileCheck %s

module {
  func.func @unaligned_alloc_multi_tile_addr() attributes {pto.entry} {
    %bad = arith.constant 4 : i64
    %buf = pto.alloc_multi_tile addr = %bad
      : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
    return
  }
}

// CHECK: 'pto.alloc_multi_tile' op addr must be aligned to 32 bytes for local tile memory space, got 4
