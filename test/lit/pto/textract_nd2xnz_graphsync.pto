// RUN: ptoas --pto-arch a5 --enable-graph-sync-solver --graph-sync-solver-event-id-max=8 %s | FileCheck %s
// RUN: ptoas --pto-arch a5 --enable-graph-sync-solver --graph-sync-solver-event-id-max=4 %s 2>&1 | FileCheck %s
// Regression (design doc 6.3.1): the event-id allocator for the V/S and
// S/V pipe pairs reserves event 0 when the kernel carries an ND-to-2xNZ
// TEXTRACT. The usable window [1, maxEventId] must survive a shrink and
// never hand out a duplicate or an id above the hardware maximum.

module attributes {"pto.target_arch" = "a5"} {
  func.func @textract_nd2xnz_graphsync() {
    %r0 = arith.constant 0 : index
    %c0 = arith.constant 0 : index
    %r1 = arith.constant 8 : index
    %c1 = arith.constant 16 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %r0, %c0, %r1, %c1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: AICORE void textract_nd2xnz_graphsync(
// The dual-output form emits exactly one seven-operand public TEXTRACT call.
// CHECK: TEXTRACT([[DST0:[^, ]+]], [[DST1:[^, ]+]], [[SRC:[^, ]+]], [[R0:[^, ]+]], [[C0:[^, ]+]], [[R1:[^, ]+]], [[C1:[^)]+]]);
