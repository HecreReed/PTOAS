// RUN: not ptoas --pto-level=level3 --pto-arch=a3 %s 2>&1 | FileCheck %s

module {
  func.func @unresolved_subview_arg(
      %tile: !pto.tile_buf<vec, 16x16xf32>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %sub = pto.subview %tile[%c0, %c0] sizes [8, 16]
      : !pto.tile_buf<vec, 16x16xf32>
     -> !pto.tile_buf<vec, 8x16xf32>
    pto.tprint ins(%sub : !pto.tile_buf<vec, 8x16xf32>)
    return
  }
}

// CHECK: failed to legalize operation 'pto.subview' that was explicitly marked illegal
