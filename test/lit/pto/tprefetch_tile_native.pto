// RUN: ptoas --pto-level=level3 --pto-arch=a3 --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 %s | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tprefetch_arg(%src: !pto.partition_tensor_view<16x16xf16>, %dst: !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {
    pto.tprefetch ins(%src : !pto.partition_tensor_view<16x16xf16>)
                  outs(%dst : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// NATIVE-LABEL: @tprefetch_arg
// NATIVE-SAME: %{{.*}}: !pto.partition_tensor_view<16x16xf16>
// NATIVE-SAME: %{{.*}}: !pto.tile_buf<vec
// NATIVE: pto.tprefetch

// EMITC-LABEL: tprefetch_arg(
// EMITC: TPREFETCH(
