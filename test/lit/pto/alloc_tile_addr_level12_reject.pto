// RUN: not ptoas --pto-level=level1 %s 2>&1 | FileCheck %s
// RUN: not ptoas --pto-level=level2 %s 2>&1 | FileCheck %s

module {
  func.func @reject_explicit_addr_below_level3() {
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr
        : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    return
  }
}

// CHECK: error: unexpected 'addr' operand: only supported when --pto-level=level3
