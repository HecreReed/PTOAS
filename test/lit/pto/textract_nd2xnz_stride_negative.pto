// RUN: not ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s
// Negative: destination physical rows must fit the A5 vsstb 16-bit block
// stride (design 9.2); an oversized stride would silently truncate.

module attributes {"pto.target_arch" = "a5"} {
  func.func @textract_nd2xnz_stride_overflow() {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=65536, cols=32, v_row=65535, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %d0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=65536, cols=16, v_row=65535, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %d1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=65536, cols=32, v_row=65535, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                outs(%d0, %d1 : !pto.tile_buf<loc=vec, dtype=f16, rows=65536, cols=16, v_row=65535, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// CHECK: vsstb 16-bit block stride
