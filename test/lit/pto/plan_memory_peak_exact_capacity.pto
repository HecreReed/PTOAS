// RUN: ptoas --mlir-print-ir-after=pto-plan-memory %s 2>&1 1>/dev/null | FileCheck %s

module {
  func.func @peak_exact_capacity(%arg0: memref<32x32x32xf16, #pto.address_space<gm>>,
                                 %arg1: memref<32x32x32xf16, #pto.address_space<gm>>) {
    // Default UB size is 1572864 bytes (12582912 bits). Each buffer here is
    // 32*32*32*f16 = 65536 bytes. 24 buffers live at once should fit exactly:
    //   24 * 65536 = 1572864 bytes.
    %u0 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u1 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u2 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u3 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u4 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u5 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u6 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u7 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u8 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u9 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u10 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u11 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u12 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u13 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u14 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u15 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u16 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u17 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u18 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u19 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u20 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u21 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u22 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>
    %u23 = memref.alloc() : memref<32x32x32xf16, #pto.address_space<vec>>

    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u0 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u1 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u2 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u3 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u4 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u5 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u6 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u7 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u8 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u9 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u10 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u11 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u12 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u13 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u14 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u15 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u16 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u17 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u18 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u19 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u20 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u21 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u22 : memref<32x32x32xf16, #pto.address_space<vec>>)
    pto.tload ins(%arg0 : memref<32x32x32xf16, #pto.address_space<gm>>)
             outs(%u23 : memref<32x32x32xf16, #pto.address_space<vec>>)

    pto.tstore ins(%u0 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u1 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u2 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u3 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u4 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u5 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u6 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u7 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u8 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u9 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u10 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u11 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u12 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u13 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u14 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u15 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u16 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u17 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u18 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u19 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u20 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u21 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u22 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    pto.tstore ins(%u23 : memref<32x32x32xf16, #pto.address_space<vec>>)
              outs(%arg1 : memref<32x32x32xf16, #pto.address_space<gm>>)
    return
  }
}

// CHECK: IR Dump After PlanMemory
// CHECK: func.func @peak_exact_capacity
// CHECK-NOT: memref.alloc
// 24 live buffers implies a max offset of 23*65536 = 1507328 bytes.
// CHECK: %[[O1507328:.*]] = arith.constant 1507328 : i64
// CHECK: pto.pointer_cast(%[[O1507328]]) : memref<32x32x32xf16, #pto.address_space<{{vec|ub}}>>
