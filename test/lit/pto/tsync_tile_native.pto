// RUN: ptoas --pto-level=level3 --pto-arch=a5 --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a5 %s | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tsync_tile_arg(%event: !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {
    pto.tsync ins(%event : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// NATIVE-LABEL: @tsync_tile_arg
// NATIVE-SAME: !pto.tile_buf<vec
// NATIVE: pto.tsync

// EMITC-LABEL: tsync_tile_arg(
// EMITC: TSYNC(
