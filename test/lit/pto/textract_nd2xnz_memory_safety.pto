//--- partial_alias_store.pto
module {
  func.func @partial_alias_store(%out : !pto.partition_tensor_view<1x4x2x16x16xf16>) {
    %c0 = arith.constant 0 : index
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 16384 : i64
    %addr2 = arith.constant 20480 : i64
    %src = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %partial = pto.alloc_tile addr = %addr1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=63, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dump_alias = pto.alloc_tile addr = %addr1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile addr = %addr2 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                 outs(%partial, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=63, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    pto.tstore ins(%dump_alias : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
               outs(%out : !pto.partition_tensor_view<1x4x2x16x16xf16>) {layout = #pto.layout<nz>}
    return
  }
}

//--- static_multi_tile.pto
module {
  func.func @static_multi_tile() {
    %c0 = arith.constant 0 : index
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 16384 : i64
    %addr2 = arith.constant 20480 : i64
    %src_multi = pto.alloc_multi_tile addr = %addr0 : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
    %dst0_multi = pto.alloc_multi_tile addr = %addr1 : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, count=2>
    %dst1_multi = pto.alloc_multi_tile addr = %addr2 : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>, count=2>
    %src = pto.multi_tile_get %src_multi[%c0] : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2> -> !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.multi_tile_get %dst0_multi[%c0] : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, count=2> -> !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.multi_tile_get %dst1_multi[%c0] : !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>, count=2> -> !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                 outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

