// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %t/declared.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PROVENANCE
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/tassign.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=TASSIGN
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/dynamic_addr.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=DYNAMIC
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/static_non_overlap.pto -o /dev/null
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/static_multi_tile.pto -o /dev/null
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/static_overlap.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=OVERLAP
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/partial_direct_store.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL-DIRECT
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/partial_alias_store.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL-ALIAS
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/partial_overlap_store.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL-OVERLAP
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir \
// RUN:   %t/partial_unknown_store.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL-UNKNOWN

// PROVENANCE: ND-to-2xNZ src must be allocation-backed by pto.alloc_tile or pto.multi_tile_get
// PROVENANCE: unsupported provenance root is pto.declare_tile
// TASSIGN: ND-to-2xNZ src must be allocation-backed by pto.alloc_tile or pto.multi_tile_get
// TASSIGN: unsupported provenance root is pto.tassign
// DYNAMIC: ND-to-2xNZ src must resolve to a static allocation-backed physical byte range after memory planning
// OVERLAP: PlanMemory semantic no-alias violation: operand byte ranges overlap
// PARTIAL-DIRECT: source physical byte range aliases a partial-valid ND-to-2xNZ destination
// PARTIAL-ALIAS: source physical byte range aliases a partial-valid ND-to-2xNZ destination
// PARTIAL-ALIAS: undefined NZ padding cannot be stored
// PARTIAL-OVERLAP: source physical byte range aliases a partial-valid ND-to-2xNZ destination
// PARTIAL-UNKNOWN: cannot prove that TSTORE source is disjoint from a partial-valid ND-to-2xNZ destination

//--- declared.pto
module {
  func.func @declared_provenance() {
    %c0 = arith.constant 0 : index
    %src = pto.declare_tile -> !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                 outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

//--- tassign.pto
module {
  func.func @tassign_provenance() {
    %c0 = arith.constant 0 : index
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 16384 : i64
    %addr2 = arith.constant 20480 : i64
    %declared = pto.declare_tile -> !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src = pto.tassign %declared, %addr0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0> -> !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile addr = %addr1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile addr = %addr2 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                 outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

//--- dynamic_addr.pto
module {
  func.func @dynamic_address(%base : i64) {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile addr = %base : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst0 = pto.alloc_tile addr = %base : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %dst1 = pto.alloc_tile addr = %base : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.textract ins(%src, %c0, %c0, %c0, %c0 : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=128, v_row=64, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index, index, index)
                 outs(%dst0, %dst1 : !pto.tile_buf<loc=vec, dtype=f16, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

