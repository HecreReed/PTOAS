// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @mgather_arg(
      %mem: !pto.partition_tensor_view<1x1x1x8x16xf16>,
      %idx: !pto.tile_buf<vec, 8x16xi32>,
      %dst: !pto.tile_buf<vec, 8x16xf16>) {
    pto.mgather ins(%mem, %idx : !pto.partition_tensor_view<1x1x1x8x16xf16>, !pto.tile_buf<vec, 8x16xi32>)
                outs(%dst : !pto.tile_buf<vec, 8x16xf16>)
                {coalesce = #pto<coalesce elem>, gatherOob = #pto<gather_oob zero>}
    return
  }

  func.func private @mscatter_arg(
      %src: !pto.tile_buf<vec, 8x16xf16>,
      %idx: !pto.tile_buf<vec, 8x16xi32>,
      %mem: !pto.partition_tensor_view<1x1x1x8x16xf16>) {
    pto.mscatter ins(%src, %idx : !pto.tile_buf<vec, 8x16xf16>, !pto.tile_buf<vec, 8x16xi32>)
                 outs(%mem : !pto.partition_tensor_view<1x1x1x8x16xf16>)
                 {coalesce = #pto<coalesce elem>, scatterOob = #pto<scatter_oob skip>}
    return
  }
}

// NATIVE-LABEL: func.func private @mgather_arg
// NATIVE-SAME: !pto.partition_tensor_view<1x1x1x8x16xf16>
// NATIVE-SAME: !pto.tile_buf<vec, 8x16xi32>
// NATIVE-SAME: !pto.tile_buf<vec, 8x16xf16>
// NATIVE: pto.mgather
// NATIVE-LABEL: func.func private @mscatter_arg
// NATIVE-SAME: !pto.tile_buf<vec, 8x16xf16>
// NATIVE-SAME: !pto.tile_buf<vec, 8x16xi32>
// NATIVE-SAME: !pto.partition_tensor_view<1x1x1x8x16xf16>
// NATIVE: pto.mscatter

// EMITC-LABEL: mgather_arg(
// EMITC: MGATHER<pto::Coalesce::Elem, pto::GatherOOB::Zero>(
// EMITC-LABEL: mscatter_arg(
// EMITC: MSCATTER<pto::Coalesce::Elem, pto::ScatterAtomicOp::None, pto::ScatterOOB::Skip>(
