// RUN: ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @boxed_row_plus_one_stride() {
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    %tile = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=2>
    %sub = pto.subview %tile[%c0, %c8] sizes [16, 8]
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=2>
     -> !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=8, v_row=16, v_col=8, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=2>
    pto.tprint ins(%sub : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=8, v_row=16, v_col=8, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=2>)
    return
  }
}

// The boxed col-major layout's major stride is rows + 1 = 17.
// CHECK: %c17_i64 = arith.constant 17 : i64
// CHECK: arith.muli %{{.*}}, %c17_i64 : i64
