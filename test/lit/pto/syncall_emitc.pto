// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s

module {
  func.func @syncall_emitc(
      %gm: !pto.ptr<i32, gm>, %used: i32) {
    pto.syncall(%gm, %used : !pto.ptr<i32, gm>, i32) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall(%gm, %used : !pto.ptr<i32, gm>, i32) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aic_only>
    pto.syncall(%gm, %used : !pto.ptr<i32, gm>, i32) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    pto.syncall(%gm : !pto.ptr<i32, gm>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    pto.syncall() mode = #pto.sync_all_mode<hard>, core_type = #pto.sync_core_type<aiv_only>
    pto.syncall() mode = #pto.sync_all_mode<hard>, core_type = #pto.sync_core_type<aic_only>
    pto.syncall() mode = #pto.sync_all_mode<hard>, core_type = #pto.sync_core_type<mix>
    return
  }
}

// CHECK-LABEL: AICORE void syncall_emitc(
// CHECK-NOT: Tile<TileType::Vec
// CHECK-NOT: Tile<TileType::Mat
// CHECK-NOT: TASSIGN
// CHECK: pto::Shape<1, 1, 1, 1, 16>
// CHECK: pto::Stride<16, 16, 16, 16, 1>
// CHECK: GlobalTensor<int32_t, pto::Shape<1, 1, 1, 1, 16>, pto::Stride<16, 16, 16, 16, 1>, pto::Layout::ND>
// CHECK: SYNCALL<SyncAllMode::Soft, SyncCoreType::AIVOnly>({{[^,]+}}, {{[^)]+}});
// CHECK-NOT: Tile<TileType::Vec
// CHECK-NOT: Tile<TileType::Mat
// CHECK-NOT: TASSIGN
// CHECK: SYNCALL<SyncAllMode::Soft, SyncCoreType::AICOnly>({{[^,]+}}, {{[^)]+}});
// CHECK-NOT: Tile<TileType::Vec
// CHECK-NOT: Tile<TileType::Mat
// CHECK-NOT: TASSIGN
// CHECK: SYNCALL<SyncAllMode::Soft, SyncCoreType::Mix>({{[^,]+}}, {{[^)]+}});
// CHECK-NOT: Tile<TileType::Vec
// CHECK-NOT: Tile<TileType::Mat
// CHECK-NOT: TASSIGN
// CHECK: SYNCALL<SyncAllMode::Soft, SyncCoreType::Mix>({{[^,]+}}, int32_t{0});
// CHECK-NOT: Tile<TileType::Vec
// CHECK-NOT: Tile<TileType::Mat
// CHECK-NOT: TASSIGN
// CHECK: SYNCALL<SyncCoreType::AIVOnly>();
// CHECK: SYNCALL<SyncCoreType::AICOnly>();
// CHECK: SYNCALL<SyncCoreType::Mix>();
// CHECK-NOT: TASSIGN
