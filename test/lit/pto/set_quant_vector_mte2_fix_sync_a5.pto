// RUN: ptoas --pto-arch=a5 --enable-insert-sync %S/../../samples/Movfp/movfp_fixpipe_reuse-pto.pto 2>&1 | FileCheck %s

// The scaling vectors are loaded into MAT through MTE2, then copied to FBUF by
// TMOV on FIX. Both loads need a cross-pipe event before the corresponding
// copy; otherwise TPUSH can observe uninitialized scaling data.

// CHECK-LABEL: AICORE void movfp_fixpipe_reuse_aic(
// CHECK: TLOAD({{.*}}, {{.*}});
// CHECK: TLOAD({{.*}}, {{.*}});
// CHECK: TLOAD({{.*}}, {{.*}});
// CHECK-NEXT: set_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID[[FP0_READY:[0-9]+]]);
// CHECK: TLOAD({{.*}}, {{.*}});
// CHECK-NEXT: set_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID[[FP1_READY:[0-9]+]]);
// CHECK: wait_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID[[FP0_READY]]);
// CHECK-NEXT: TMOV({{.*}}, {{.*}});
// CHECK: wait_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID[[FP1_READY]]);
// CHECK-NEXT: TMOV({{.*}}, {{.*}});
// CHECK: SET_QUANT_VECTOR({{.*}});
// CHECK-NEXT: pipe_barrier(PIPE_FIX);
// CHECK-NEXT: TPUSH{{.*}};
// CHECK: SET_QUANT_VECTOR({{.*}});
// CHECK-NEXT: pipe_barrier(PIPE_FIX);
// CHECK-NEXT: TPUSH{{.*}};
