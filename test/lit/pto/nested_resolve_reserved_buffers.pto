// RUN: pto-test-opt --pto-plan-memory --pto-resolve-reserved-buffers %s | FileCheck %s

// Guard: reserved buffers in backend child modules must be planned and then
// materialized to ordinary address constants.

module {
  module attributes {pto.backend = "emitc"} {
    func.func @nested_reserve() {
      %fifo = pto.reserve_buffer {
        name = "fifo",
        size = 4096,
        location = #pto.address_space<vec>,
        auto = true
      } -> i32
      func.call @consume(%fifo) : (i32) -> ()
      return
    }
    func.func private @consume(i32)
  }
}

// CHECK-LABEL: func.func @nested_reserve
// CHECK: %[[BASE:.*]] = arith.constant 0 : i32
// CHECK: call @consume(%[[BASE]]) : (i32) -> ()
// CHECK-NOT: pto.reserve_buffer
