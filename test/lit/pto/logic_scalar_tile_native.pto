// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tands_arg(
      %src: !pto.tile_buf<vec, 16x16xi16>,
      %scalar: i16,
      %dst: !pto.tile_buf<vec, 16x16xi16>) {
    pto.tands ins(%src, %scalar : !pto.tile_buf<vec, 16x16xi16>, i16)
              outs(%dst : !pto.tile_buf<vec, 16x16xi16>)
    return
  }

  func.func private @tors_arg(
      %src: !pto.tile_buf<vec, 16x16xi16>,
      %scalar: i16,
      %dst: !pto.tile_buf<vec, 16x16xi16>) {
    pto.tors ins(%src, %scalar : !pto.tile_buf<vec, 16x16xi16>, i16)
              outs(%dst : !pto.tile_buf<vec, 16x16xi16>)
    return
  }
}

// NATIVE-LABEL: func.func private @tands_arg(
// NATIVE: pto.tands ins(%arg0, %arg1 : !pto.tile_buf<vec, 16x16xi16>, i16) outs(%arg2 : !pto.tile_buf<vec, 16x16xi16>)
// NATIVE-LABEL: func.func private @tors_arg(
// NATIVE: pto.tors ins(%arg0, %arg1 : !pto.tile_buf<vec, 16x16xi16>, i16) outs(%arg2 : !pto.tile_buf<vec, 16x16xi16>)
// NATIVE-NOT: memref<

// EMITC-LABEL: tands_arg(
// EMITC: TANDS(
// EMITC-LABEL: tors_arg(
// EMITC: TORS(
